# Copy to .env.local and fill in the values yourself. Never commit .env.local.

# Supabase (Project settings, API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never put NEXT_PUBLIC_ on this.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (test mode keys first). Server only except the publishable key.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend (email). Server only.
RESEND_API_KEY=
# Sender address. Use Resend's test sender until a domain is verified.
EMAIL_FROM="AI agency <onboarding@resend.dev>"

# The site's own address (http://localhost:3000 locally, the Vercel address in production)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
